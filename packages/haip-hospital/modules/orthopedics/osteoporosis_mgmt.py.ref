            {"name": "唑来膦酸", "dose": "5mg 每年1次", "route": "静脉输注", "note": "输注前需充分水化,监测肾功能"},
            {"name": "利塞膦酸钠", "dose": "35mg 每周1次", "route": "口服", "note": "同阿仑膦酸钠服药要求"},
        ],
