{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhaip.dev/agent-schema.json",
  "title": "xhaip Agent Definition",
  "description": "YAML-driven agent definition for Hospital AI Platform",
  "type": "object",
  "required": ["name", "cn_name", "type", "department", "port", "prompt", "tools"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique agent identifier (kebab-case)"
    },
    "cn_name": {
      "type": "string",
      "description": "Chinese display name"
    },
    "version": {
      "type": "string",
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "type": "string",
      "enum": ["business"]
    },
    "department": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "prompt": {
      "type": "object",
      "required": ["system"],
      "properties": {
        "system": {"type": "string", "minLength": 10},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent"],
        "properties": {
          "agent": {"type": "string"},
          "version": {"type": "string"}
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "handler"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 3},
          "handler": {"type": "string", "minLength": 3},
          "input": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "properties": {
        "triggers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "citation": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "min_sources": {"type": "integer", "minimum": 1},
            "min_trust": {"type": "string", "enum": ["T1", "T2"]}
          }
        },
        "high_risk_scenarios": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "template": {"type": "string"},
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "default": {"type": "boolean"}
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "id", "label"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "id": {"type": "string"},
              "label": {"type": "string"},
              "desc": {"type": "string"},
              "role": {"type": "string"},
              "role_ids": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
