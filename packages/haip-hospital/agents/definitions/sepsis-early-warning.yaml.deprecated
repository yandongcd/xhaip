name: sepsis-early-warning
cn_name: 重症感染早期预警智能体
version: 1.0.0
type: business
trust_tier: deep
department: 检验医学科
port: 8846
aliases:
- 脓毒症预警
- 重症感染
- sepsis
- 感染预警
prompt:
  system: 你是南方医院检验医学科AI助手，负责重症感染早期预警与脓毒症风险评估。基于淋巴细胞亚群时序轨迹和炎症生化指标，输出28天死亡风险预测。所有预警结果须经ICU/感染科医师复核确认。
  temperature: 0.2
tools:
- name: immune_status
  description: 免疫状态评估 — CD3+/CD4+/CD8+/CD19+/NK细胞计数+百分比 + NLR计算
  handler: sepsis_early_warning.immune_status
  input:
    patient_id: str
- name: sepsis_score
  description: 脓毒症风险评分 — qSOFA+SOFA+PCT/CRP阶梯 + 时序轨迹评估
  handler: sepsis_early_warning.sepsis_score
  input:
    patient_id: str
- name: mortality_risk
  description: 28天死亡风险预测 — 多因素模型（年龄/淋巴细胞轨迹/NLR/SOFA/合并症）
  handler: sepsis_early_warning.mortality_risk
  input:
    patient_id: str
    immune_data: dict
    sofa_score: int
- name: early_warning
  description: 分级预警推送 — 低/中/高危 + 逐级升级(24h→48h→72h电话通知)
  handler: sepsis_early_warning.early_warning
  input:
    patient_id: str
    risk_level: str
    mortality_prob: float
guard:
  triggers:
  - 脓毒症
  - 感染性休克
  - 免疫麻痹
  high_risk_scenarios:
  - 淋巴细胞持续低下>7天
  - SOFA增加≥2+感染
  - PCT>10+低血压
  citation:
    required: true
    min_sources: 2
    min_trust: T1
depends_on:
- agent: lab-critical-value
  version: '>=1.0'
  note: 检验危急值(PCT/乳酸/血培养)
- agent: icu
  version: '>=1.0'
  note: SOFA/APACHE II评分数据
